# Cloudflare Pages response headers (replaces the Expires/Cache-Control rules in .htaccess).
# index.html must always be revalidated; hashed files in /assets never change, so they are cached for a year.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=604800
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
